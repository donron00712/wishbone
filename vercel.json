{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.js",
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.kismatcookies.com"
        }
      ],
      "destination": "https://kismatcookies.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kismatcookies.com"
        }
      ],
      "destination": "https://kismatcookies.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wishbone-swart.vercel.app"
        }
      ],
      "destination": "https://kismatcookies.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wishbone-swart.vercel.app"
        }
      ],
      "destination": "https://kismatcookies.com/:path*",
      "permanent": true
    }
  ]
}
